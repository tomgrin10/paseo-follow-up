{
  "name": "paseo-follow-up",
  "private": false,
  "version": "2.0.2-beta.0",
  "description": "A Paseo plugin that follows every workspace until the work is done: one Home for what needs you, questions you answer anywhere, and repairs that send themselves.",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "assets/",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "CHANGELOG.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/screenshots/",
    "scripts/build.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --import ./tests/hermetic-env.mjs tests/*.test.ts",
    "verify": "npm run typecheck && npm run check:notes && npm test && node --test button-visibility.test.mjs && npm run test:scale && npm run test:native && npm run test:trust",
    "test:trust": "node scripts/check-trust-bypass.mjs",
    "preview": "node scripts/check-install.mjs --keep",
    "test:install": "node scripts/check-install.mjs && node scripts/check-wait.mjs && node scripts/check-archived-lookup.mjs",
    "test:move": "tsx scripts/check-move.mjs",
    "test:move:registry": "tsx scripts/check-move.mjs --registry",
    "test:github-mode": "node scripts/check-github-mode.mjs",
    "test:native": "node scripts/check-native-tools.mjs --agents 10",
    "prepare": "node scripts/build.mjs",
    "test:scale": "node scripts/scale-check.mjs --workspaces 140 --awake 5 --idle 90 --realistic --rss-budget 300 --idle-rss-budget realistic --cpu-budget 3 --request-budget 2",
    "test:scale:live": "node scripts/scale-check.mjs --workspaces 140 --awake 5 --live-sized --busy 180 --idle 90 --rss-budget 300 --idle-rss-budget 240 --cpu-budget 3 --request-budget 2 --budgets-report-only",
    "check:notes": "node scripts/release-notes.mjs --check",
    "release:version": "node scripts/release-notes.mjs --next-version",
    "release:notes": "node scripts/release-notes.mjs",
    "test:feeds": "node scripts/screenshots.mjs --only feeds --out .feeds-check",
    "test:wait": "node scripts/check-wait.mjs",
    "test:wait-live": "node scripts/check-wait.mjs --live",
    "shots": "node scripts/screenshots.mjs",
    "shots:readme": "sh scripts/readme-shots.sh"
  },
  "devDependencies": {
    "@getpaseo/client": "0.16.0-beta.1",
    "@getpaseo/plugin": "0.16.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "author": "Tom Gringauz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrin10/paseo-follow-up.git"
  },
  "homepage": "https://github.com/tomgrin10/paseo-follow-up#readme",
  "bugs": "https://github.com/tomgrin10/paseo-follow-up/issues",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "follow-up",
    "pull-requests",
    "workspaces",
    "ai-agents",
    "claude-code",
    "codex",
    "github",
    "graphite"
  ]
}
